# Adress till Home Assistant sett från servern där sajten körs
HA_URL=http://192.168.1.10:8123
# Long-lived access token (HA: Profil -> Säkerhet -> Långlivade åtkomsttoken)
HA_TOKEN=klistra-in-token-här
# Port för sajten
PORT=8780
# Valfritt: kräv inloggning, format användare:lösenord
# BASIC_AUTH=patrik:ett-bra-lösenord
